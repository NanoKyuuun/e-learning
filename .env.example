# ============================================================
# Docker Compose — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# ============================================================

# ─── Database ────────────────────────────────────────────────
DB_DATABASE=elearning
DB_USERNAME=root
DB_PASSWORD=ganti_password_kuat_disini
MYSQL_ROOT_PASSWORD=ganti_password_kuat_disini

# ─── Face Recognition API ────────────────────────────────────
# Kunci rahasia internal antara Laravel ↔ Face API
# Gunakan string panjang dan acak, minimal 32 karakter
FACE_API_KEY=ganti_dengan_kunci_acak_panjang

# ─── AI Service ──────────────────────────────────────────────
# Kunci rahasia internal antara Laravel ↔ AI Service
AI_SERVICE_API_KEY=ganti_dengan_kunci_acak_panjang

# ─── OpenRouter ──────────────────────────────────────────────
# Dapatkan dari: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model default. Contoh: openai/gpt-4o-mini, anthropic/claude-3-haiku
OPENROUTER_MODEL=openrouter/auto
